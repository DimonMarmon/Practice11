@startuml
entity "Guest" {
  * id : int
  --
  full_name : string
  email : string
  phone : string
}

entity "Room" {
  * id : int
  --
  room_number : string
  category : string
  price_per_night : decimal
  status : string
}

entity "Booking" {
  * id : int
  --
  check_in_date : date
  check_out_date : date
  total_price : decimal
  status : string
}

entity "Payment" {
  * id : int
  --
  amount : decimal
  payment_date : datetime
  payment_method : string
}

Guest ||--o{ Booking
Room ||--o{ Booking
Booking ||--|| Payment
@enduml